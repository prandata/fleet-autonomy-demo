[0.000, "o", "\u001b[1;33m# Shortcut for one session: press Shift+Tab until the mode line says bypass.\u001b[0m\r\n"]
[2.006, "o", "\r\n\u001b[1;33m# Our rule: bots may run anything, except spend, file, delete, contact outsiders, or give legal and tax advice.\u001b[0m\r\n"]
