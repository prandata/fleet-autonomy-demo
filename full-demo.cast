[1.507, "o", "\r\n\u001b[1;33m# Step 4. Start a new Claude Code session. Press Shift+Tab to cycle modes live.\u001b[0m\r\n"]
[2.006, "o", "\r\n\u001b[1;33m# The mode line shows: default, then accept edits, then plan, then bypass.\u001b[0m\r\n"]
